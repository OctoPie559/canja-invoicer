# --- Database (Neon) -------------------------------------------------------
# Neon dashboard → your project → Connection string (pooled)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Better Auth ------------------------------------------------------------
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The app's public URL (http://localhost:3000 in dev)
BETTER_AUTH_URL=http://localhost:3000

# --- Email (Resend) — optional in dev; console fallback logs emails ---------
# Requires SPF/DKIM/DMARC on a dedicated sending subdomain before real sends
RESEND_API_KEY=
EMAIL_FROM="invoicer <no-reply@send.yourdomain.co.ke>"
# Publicly reachable origin serving public/static/ — email clients fetch
# images through their own proxies, so localhost never works in delivered
# emails. Set to your deployed URL when sending real emails from local dev;
# defaults to BETTER_AUTH_URL, which is correct on deployed environments.
EMAIL_ASSET_BASE_URL=

# --- Sentry — DSN defaults to the project DSN baked into the configs; ---------
# --- set these to override per environment (or "" to disable) ------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Only needed in CI/Vercel for source-map upload
SENTRY_AUTH_TOKEN=

# --- Cron ---------------------------------------------------------------------
# Protects /api/cron/* endpoints; Vercel Cron sends it as a Bearer token.
# Generate: openssl rand -base64 32
CRON_SECRET=

# --- Cloudflare R2 (branding logos & future images) — optional until slice 4 --
# Bucket must be public behind a custom domain (R2_PUBLIC_BASE_URL).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
