{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/slice-merge-gate.sh",
            "timeout": 15,
            "statusMessage": "Checking slice-verifier gate"
          }
        ]
      }
    ]
  }
}
